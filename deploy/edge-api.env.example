# Copy to /etc/edge-api/edge-api.env on the phone and fill in real values.
# Sourced by the OpenRC service (deploy/openrc/edge-api) at start.

LISTEN_ADDR=:8080

DATABASE_URL=postgres://user:pass@REAL_SERVER_IP:5432/app?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=2

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

CACHE_TTL_SECONDS=30
