# HTTP listener on the phone (nginx proxies to this)
LISTEN_ADDR=:8080

# Remote PostgreSQL on the real server. Use sslmode=require (or WireGuard).
DATABASE_URL=postgres://user:pass@REAL_SERVER_IP:5432/app?sslmode=require

# pgxpool sizing — phone is NOT the DB, keep the pool small but warm.
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Redis cache (local on the phone).
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# How long cached DB reads live before a fresh round-trip.
CACHE_TTL_SECONDS=30
