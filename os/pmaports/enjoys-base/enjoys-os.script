# enjoys-os Plymouth boot splash: fade in the logo on a dark background.

Window.SetBackgroundTopColor(0.043, 0.063, 0.125);
Window.SetBackgroundBottomColor(0.027, 0.035, 0.063);

logo.image = Image("logo.png");

# Scale the logo down if it is wider than 70% of the screen.
max_width = Window.GetWidth() * 0.7;
if (logo.image.GetWidth() > max_width)
{
    ratio = max_width / logo.image.GetWidth();
    logo.image = logo.image.Scale(logo.image.GetWidth() * ratio,
                                  logo.image.GetHeight() * ratio);
}

logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(0);

global.opacity = 0;

fun refresh_callback()
{
    if (opacity < 1)
    {
        opacity += 0.02;
        logo.sprite.SetOpacity(opacity);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Boot/shutdown status messages, centered under the logo.
message.sprite = Sprite();
fun message_callback(text)
{
    message.image = Image.Text(text, 0.7, 0.8, 1.0);
    message.sprite.SetImage(message.image);
    message.sprite.SetX(Window.GetWidth() / 2 - message.image.GetWidth() / 2);
    message.sprite.SetY(Window.GetHeight() * 0.82);
}
Plymouth.SetMessageFunction(message_callback);
