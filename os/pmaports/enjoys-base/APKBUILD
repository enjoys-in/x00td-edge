# Maintainer: you <you@example.com>
#
# enjoys-os base: a minimal headless SSH node + boot splash.
# Pulls in openssh and the plymouth bootsplash; installs the enjoys-os splash
# theme; sets up root login + branded MOTD and enables sshd via post-install.
# (Docker + Caddy were removed in 0.2.0 to keep the image small — ~190 MB.)

pkgname=enjoys-base
pkgver=0.2.0
pkgrel=0
pkgdesc="enjoys-os base: minimal headless SSH node, root login + branded MOTD"
url="https://local/enjoys-os"
arch="noarch"
license="MIT"
depends="openssh postmarketos-bootsplash"
install="$pkgname.post-install"
source="enjoys-os.plymouth
	enjoys-os.script
	logo.png"
options="!check"

package() {
	# Plymouth boot splash theme with the enjoys-os logo. plymouthd.conf and the
	# Caddyfile are written in post-install instead — those paths are owned by the
	# plymouth/caddy packages and can't be shipped without an apk file conflict.
	install -Dm644 "$srcdir/enjoys-os.plymouth" "$pkgdir/usr/share/plymouth/themes/enjoys-os/enjoys-os.plymouth"
	install -Dm644 "$srcdir/enjoys-os.script"   "$pkgdir/usr/share/plymouth/themes/enjoys-os/enjoys-os.script"
	install -Dm644 "$srcdir/logo.png"           "$pkgdir/usr/share/plymouth/themes/enjoys-os/logo.png"
}
sha512sums="
